{
  "name": "dsh-xuexi",
  "version": "2.2.2",
  "description": "DSH 网课模式：工具只当手和眼，判断全归大模型 —— 截图、列能点的、点一个看变化，任何网课页面都能自己摸出来",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "scripts": {
    "test": "node test/run.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "prompts",
    "lib"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent-preset",
    "browser-automation",
    "cdp",
    "llm-agent",
    "online-course"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeuJasYoh/dsh-xuexi.git"
  },
  "bugs": {
    "url": "https://github.com/LeuJasYoh/dsh-xuexi/issues"
  },
  "homepage": "https://github.com/LeuJasYoh/dsh-xuexi#readme",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "id": "dsh-xuexi",
    "name": "网课模式",
    "version": "2.2.2",
    "repo": "LeuJasYoh/dsh-xuexi",
    "engines": {
      "dsh": ">=0.2.0"
    },
    "permissions": "接管浏览器, 注册 Agent 预设, 系统提示词注入, 工具注册",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
